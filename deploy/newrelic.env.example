# New Relic for the timelapsed daemons.
#
# install.sh copies this to /etc/timelapsed-newrelic.env, where every unit
# reads it via EnvironmentFile=- (the dash makes it optional). With no key set
# the agent never starts, so this file is safe to install everywhere and only
# does something once a key is pasted in and the services are restarted:
#
#   sudoedit /etc/timelapsed-newrelic.env
#   sudo systemctl restart timelapsed timelapsed-web timelapsed-analyzer timelapsed-archiver
#
# The key is an INGEST - LICENSE key (one exists under "API keys" on a fresh
# account). It is a credential: the file is root-only, same reasoning as the
# NVR password in /etc/timelapsed.ini.
NEW_RELIC_LICENSE_KEY=

# Each unit already names its own APM service (timelapsed-capture,
# timelapsed-web, timelapsed-analyzer, timelapsed-archiver); there is nothing
# else to configure. Occasionally useful:
# NEW_RELIC_LOG_LEVEL=warning
