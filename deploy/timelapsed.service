[Unit]
Description=Timelapsed NVR capture daemon
Documentation=https://github.com/delissonjunio/timelapsed/blob/main/docs/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timelapsed
Group=timelapsed
ExecStart=/opt/timelapsed/.venv/bin/python -m timelapsed
Restart=always
RestartSec=10

# The capture loop is the only thing that should be writing here.
StateDirectory=timelapsed
WorkingDirectory=/opt/timelapsed

# ffmpeg is CPU-hungry; keep it from starving the rest of the guest.
Nice=10
CPUWeight=50
IOWeight=50

# And memory-hungry: a 1080p render peaks around 250 MB. max_concurrent_renders
# keeps that to one at a time, and this is the belt to that braces -- a runaway
# render is reclaimed and then killed inside this cgroup, instead of the kernel
# picking whichever process on the guest happens to look expensive.
#
# The numbers are sized against a 2 GB guest: roughly 550 MB of anonymous memory
# with a render in flight, and room above it for the page cache a render churns
# through. Set MemoryHigh too close to that and the cgroup spends the whole
# render being throttled while the kernel reclaims the frames it is still
# reading. Raise both alongside max_concurrent_renders, never on their own.
MemoryAccounting=true
MemoryHigh=1G
MemoryMax=1400M

# Hardening. The daemon needs the library path, its config, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/timelapsed

[Install]
WantedBy=multi-user.target
