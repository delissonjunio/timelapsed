[Unit]
Description=Timelapsed web viewer
Documentation=https://github.com/delissonjunio/timelapsed/blob/main/docs/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timelapsed
Group=timelapsed
ExecStart=/opt/timelapsed/.venv/bin/python -m timelapsed.web
Restart=always
RestartSec=10
WorkingDirectory=/opt/timelapsed

# The viewer only ever reads the library.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadOnlyPaths=/var/lib/timelapsed

[Install]
WantedBy=multi-user.target
