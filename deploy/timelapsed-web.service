[Unit]
Description=Timelapsed web viewer
Documentation=https://github.com/delissonjunio/timelapsed/blob/main/docs/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timelapsed
Group=timelapsed
ExecStart=/opt/timelapsed/.venv/bin/python -m timelapsed.web
Restart=always
RestartSec=10
WorkingDirectory=/opt/timelapsed

# The viewer only ever reads the library.
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadOnlyPaths=/var/lib/timelapsed
# The recognition index is the one exception. SQLite in WAL mode writes the -shm
# and -wal sidecars even for a read-only connection, so a purely read-only mount
# here makes every recognition query fail with "attempt to write a readonly
# database". The viewer's only real write is naming an identity.
#
# The leading '-' matters: recognition is optional, so this directory often does
# not exist. Without it systemd cannot build the namespace and the viewer dies
# with 226/NAMESPACE -- taking down timelapse playback over a feature that was
# never switched on.
ReadWritePaths=-/var/lib/timelapsed/index

[Install]
WantedBy=multi-user.target
