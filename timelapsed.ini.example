# Timelapsed configuration.
#
# Copy to one of these locations; later paths override earlier ones per key:
#   /etc/timelapsed.ini      (system-wide, used by the systemd units)
#   ~/.timelapsed.ini        (per user)
#   ./timelapsed.ini         (working directory)
#
# This file contains an NVR password. chmod 600 it and never commit it.

[nvr]
# Base URL of the NVR. No trailing path; ISAPI paths are appended automatically.
url = http://192.168.1.10
username = admin
password = CHANGE_ME
# NVR channel numbers, comma separated. Channel 1 maps to ISAPI channel 101.
channels = 1,2,3

[capture]
# How long to wait between snapshots, per channel.
interval_seconds = 5
resolution.width = 1920
resolution.height = 1080

[timelapse]
# Target length of a rendered video, in seconds. Surplus frames are sampled out,
# so this holds regardless of how many images the window contains.
duration_seconds = 60
# Playback frame rate of the rendered video.
output_fps = 30
# Refuse to render anything shorter than this many frames.
min_frames = 60
# Which timelapses to produce. Any of: hourly, daily, weekly, monthly, progress.
#
# hourly/daily/weekly sample the captured stills. monthly and progress instead
# read the keyframe track -- one still per day, see [keyframe] -- because a month
# of stills does not fit on any sane disk. `monthly` is one calendar month at a
# frame a day; `progress` is every keyframe ever captured in one video, refreshed
# on the 1st. Those two are what a construction record is made of.
cadences = hourly,daily,weekly
# Wall clock the cadences roll over on, as an IANA zone name. UTC means a
# daily closes at midnight UTC; set your own zone to have it close at your
# midnight instead. Stored filenames stay UTC either way.
timezone = UTC
# Per-cadence overrides of output_fps and min_frames. The baselines above are
# tuned for a window holding thousands of stills and are wrong for one frame a
# day in both directions -- at 30 fps a 31-frame month plays in one second, and a
# 60-frame minimum would refuse to render a month that can never hold more than
# 31 -- so monthly and progress use their own defaults (6 fps, and 5 and 10
# frames) rather than inheriting. Set these only to override that.
#output_fps.monthly = 6
#min_frames.monthly = 5
# Even out the camera's auto-exposure between frames a day apart. Only ever
# applied to the keyframe-sourced renders: in an hourly, frames are seconds apart
# and the changing light IS the content.
deflicker = true
# How many renders may run at once across ALL channels. Every channel rolls over
# at the same instant, and each 1080p ffmpeg peaks around 250 MB, so on a small
# guest this is the difference between renders finishing and the OOM killer
# taking them. Raise it only if there is RAM per render to spare.
max_concurrent_renders = 1

[keyframe]
# The daily construction-progress frame: one still per channel per day, hardlinked
# out of the capture window into a track that is kept for years. Only read when a
# keyframe-sourced cadence (monthly, progress) is enabled.
#
# Local wall-clock time to take it at, on the [timelapse] timezone. Noon is the
# default because a constant sun angle is what makes a months-long timelapse
# watchable, and noon exists unambiguously in every zone -- which midnight does
# not. Changing it after the fact does not move the keyframes already taken.
at = 12:00
# How far from `at` a stored still may be and still count as that day's frame. No
# still within this of the time (the camera was down over noon) and that day is
# simply absent from the video. Must be longer than interval_seconds.
tolerance_minutes = 30

[image_capture_library]
# Where images and videos are written. Needs a lot of room; see docs/Storage-Planning.md.
root = /var/lib/timelapsed
# Delete captured stills older than this. 0 keeps them forever, which will fill the disk.
# Must be GREATER than the longest STILL-sourced cadence window: weekly renders
# need 7 days of stills. monthly and progress do not read this track and so do not
# constrain it.
image_retention_days = 8
# Delete promoted keyframes older than this. 0 keeps them forever, which is the
# right answer: six channels at 231 KB a day is about 500 MB a YEAR, and they are
# the one thing in the library that cannot be rebuilt -- once the still behind a
# keyframe is pruned, that day is gone for good. Anything shorter than 32 days
# stops a monthly render working at all.
keyframe_retention_days = 0
# Delete rendered videos older than this. 0 keeps them forever, and per-cadence
# overrides win over the baseline. Timelapse footage compresses badly (frames are
# minutes apart), so a full 60-second render is ~140 MB and daily is the cadence
# that actually eats disk. Bound hourly and daily; keep the rest as the archive.
# Leave progress at 0: its start is day one of the project, so an age-based prune
# would delete the current video. Each render supersedes the last instead.
timelapse_retention_days.hourly = 7
timelapse_retention_days.daily = 90
timelapse_retention_days.weekly = 0
timelapse_retention_days.monthly = 0
timelapse_retention_days.progress = 0
# Hard floor on free space, in GB. Retention bounds how OLD files get, not how
# many BYTES they take, so it cannot promise the disk stays writable if the
# channel count, image size or video archive grows. Drop below this floor and
# the daemon deletes past retention until it is met again, sacrificing in this
# order: stills no render still needs, hourly videos, stills an upcoming render
# needs, daily videos, progress videos, monthly videos, and weekly videos last.
# Keyframes are never taken -- they are unrecoverable, and half a percent of the
# disk. 0 disables the floor entirely.
min_free_disk_gb = 5

[web]
# The built-in viewer. Bind to 0.0.0.0 and put Tailscale Serve in front of it,
# or bind to 127.0.0.1 if something else is proxying. There is no authentication.
#
# `install.sh --with-nginx` rewrites these two to 127.0.0.1:8081 and gives nginx
# the public 8080, so that rendered videos come off the disk instead of through
# Python. See docs/Viewing-Timelapses.md.
host = 0.0.0.0
port = 8080

[analysis]
# Recognition: find people and vehicles in the stills capture already wrote,
# group them into events, and read plates where they are big enough to read.
# Runs as a separate daemon (timelapsed-analyzer), so it never eats into the
# capture loop's interval budget. Off by default; it costs ~170 MB of models
# and about one core-hour per day for six channels at a 10s interval.
enabled = false

# Where the index, crops and models live. Deliberately outside the per-channel
# image/ and timelapse/ trees so the library's pruning never walks it.
# root = /var/lib/timelapsed/index

# Minimum detector confidence. This is the single most important setting here.
# At 0.35 the detector reports scenery as objects: a neighbouring building seen
# over the wall scored as a vehicle on 70% of night frames, and a pile of tools
# on a workshop floor scored as a car. At 0.50 every one of those disappeared.
# Lower it and you will get phantom events, not extra detail.
score_threshold = 0.5

# ONNX Runtime threads per model. The analyzer is nice'd below capture, so this
# is about latency per frame, not about winning the CPU.
threads = 2
# Frames per channel per pass, so one busy channel cannot starve the others
# while a backfill drains.
batch_size = 200

# How long to keep the index. Events are the durable record and are small;
# the per-frame detection rows behind them are numerous and disposable.
# 0 keeps them forever.
detection_retention_days = 30
event_retention_days = 365

# Person grouping by body appearance -- NOT face recognition. Faces on cameras
# mounted for area coverage are ~38px wide here, against the ~80px a face
# embedding needs, so faces carry no usable identity signal. Bodies are ~347px
# tall, which is what re-identification models are trained on.
#
# What this gives you is "the same person, in the same clothes, today". It does
# not survive a change of outfit, and it is not identity.
reid_enabled = true
# How similar two crops must be for a new sighting to join an existing group as
# it arrives. Kept strict: creating a wrong group online is hard to undo.
reid_threshold = 0.8
# Matching as sightings arrive fragments badly -- one person bends over, turns
# away, is half hidden by a post, and each of those fails to match the frontal
# view. A single person across one day came out as 156 separate groups.
#
# This is the pass that puts them back together, after the fact, by linking any
# two groups that share a similar enough pair of crops. Fragments are not
# islands: a back view does not match a frontal view, but both match the
# three-quarter views in between.
#
# Measured on this deployment's own footage, 156 groups consolidate to:
#   0.85 -> 147   0.80 -> 122   0.75 -> 72   0.70 -> 47   0.60 -> 20
# 0.75 is the default because it is the last value that still tells the two
# people actually on camera apart -- one in a red shirt and dark trousers, one
# in a red shirt and blue jeans. At 0.70 those two become one group.
reid_merge_threshold = 0.75
# Beyond this, appearance is not comparable. Matching across it produces
# confident nonsense as soon as somebody changes clothes.
reid_window_hours = 12

# Channels to read plates on, comma separated. Empty disables plate reading.
# Only worth enabling where plates are actually large enough to read: measured
# here, one channel yields 52-65px plates and reads them, while others sit at
# ~40px and produce garbage. See docs/Recognition-Feasibility.md.
plate_channels =
# Minimum OCR confidence per read. Below ~0.7 the model returns plausible
# nonsense on things that are not plates. Reads are also voted across every
# frame of a sighting and checked against the Brazilian plate layouts, so this
# is one guard of three.
plate_confidence = 0.7

[archive]
# Full-segment replica of what the NVR itself records, kept by the archiver
# daemon (timelapsed-archiver). It downloads every recorded segment the footage
# mirror lists -- oldest first, sequentially -- remuxes it to MP4 and files it
# under {root}/{channel}/{YYYYMMDD}/. Requires [analysis] to be enabled: the
# analyzer daemon is what maintains the footage mirror this reads.
#
# Empty disables it. Point it at a volume sized for the job before enabling:
# this NVR records ~40 GB/day across six channels.
root =
# Days of footage to keep. 0 keeps everything until the free-space floor bites.
retention_days = 0
# Free space on the archive volume below which the oldest whole days are
# dropped, oldest first. Generous because a day of footage is ~40 GB and the
# floor has to absorb most of one arriving between reclaim passes.
min_free_disk_gb = 50

[general]
logging_level = INFO
